<?xml version="1.0" encoding="utf-8"?>
<!-- Square-shaped popup background with 4dp corner radius as required -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#263238" />
    <stroke
        android:width="1.5dp"
        android:color="#00E5FF" />
    <corners android:radius="4dp" />
    <padding
        android:left="8dp"
        android:top="6dp"
        android:right="8dp"
        android:bottom="6dp" />
</shape>
