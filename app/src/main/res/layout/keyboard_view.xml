<?xml version="1.0" encoding="utf-8"?>
<!-- Full keyboard root layout with separated Top Toolbar, SuggestionStrip, and Bottom Row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboard_root_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0E1118"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 1. Top Action Toolbar (Explicit 50dp height, non-clipping, vertically centered) -->
    <HorizontalScrollView
        android:id="@+id/toolbar_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#141923"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/toolbar_actions_container"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Clipboard Tool -->
            <LinearLayout
                android:id="@+id/tool_clipboard"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/tool_clipboard_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:tint="#00E5FF"
                    android:contentDescription="الحافظة" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الحافظة"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Translation Tool -->
            <LinearLayout
                android:id="@+id/tool_translate"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/tool_translate_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:tint="#00E5FF"
                    android:contentDescription="الترجمة" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ترجمة"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Numbers 123 Tool -->
            <LinearLayout
                android:id="@+id/tool_numbers_lock"
                android:layout_width="56dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/tool_numbers_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:tint="#00E5FF"
                    android:contentDescription="تثبيت الأرقام" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="أرقام 123"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Decoration Tool -->
            <LinearLayout
                android:id="@+id/tool_decoration"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/tool_decoration_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:tint="#00E5FF"
                    android:contentDescription="زخرفة" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="زخرفة"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- AI Assistant Tool -->
            <LinearLayout
                android:id="@+id/tool_ai_assistant"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/tool_ai_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:tint="#00E5FF"
                    android:contentDescription="ذكاء اصطناعي" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ذكاء AI"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>

            <!-- Settings Tool -->
            <LinearLayout
                android:id="@+id/tool_settings"
                android:layout_width="52dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/tool_settings_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:tint="#00E5FF"
                    android:contentDescription="إعدادات" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إعدادات"
                    android:textColor="#E0E0E0"
                    android:textSize="9sp"
                    android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 2. Word Prediction Strip (Separated cleanly from toolbar) -->
    <LinearLayout
        android:id="@+id/suggestion_strip"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:background="#0A0D14"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/suggestion_left"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/suggestion_center"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.4"
            android:gravity="center"
            android:textColor="#00E5FF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground" />

        <TextView
            android:id="@+id/suggestion_right"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:background="?android:attr/selectableItemBackground" />
    </LinearLayout>

    <!-- 3. Key Grid Container (Populated dynamically) -->
    <LinearLayout
        android:id="@+id/keyboard_keys_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="3dp"
        android:paddingBottom="2dp"
        android:clipChildren="false"
        android:clipToPadding="false" />

    <!-- 4. Bottom Row Elements Structure -->
    <LinearLayout
        android:id="@+id/bottom_row_container"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:weightSum="10">

        <!-- [!123 #()] Symbol layout toggle -->
        <Button
            android:id="@+id/key_symbols_toggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:text="!123 #()"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1C2230" />

        <!-- [🌐 / 文A] Dedicated Language switcher button -->
        <ImageButton
            android:id="@+id/key_language_switch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:contentDescription="تبديل اللغة"
            android:tint="#00E5FF"
            android:backgroundTint="#1C2230" />

        <!-- [📋] Dedicated Clipboard button -->
        <ImageButton
            android:id="@+id/key_clipboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:contentDescription="الحافظة"
            android:tint="#00E5FF"
            android:backgroundTint="#1C2230" />

        <!-- [ Spacebar ] Expandable spacebar with swipe support and dynamic label -->
        <FrameLayout
            android:id="@+id/key_spacebar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.8"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="#1C2230">

            <TextView
                android:id="@+id/spacebar_language_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="عربي أساسي"
                android:textColor="#E0E0E0"
                android:textSize="13sp" />
        </FrameLayout>

        <!-- [ . ] Period key -->
        <Button
            android:id="@+id/key_period"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.8"
            android:text="."
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1C2230" />

        <!-- [ 😊 ] Emoji picker shortcut -->
        <Button
            android:id="@+id/key_emoji_shortcut"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.9"
            android:text="😊"
            android:textSize="15sp"
            android:backgroundTint="#1C2230" />

        <!-- [ ↵ ] Action / Enter key -->
        <ImageButton
            android:id="@+id/key_enter_action"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:contentDescription="إدخال"
            android:tint="#FFFFFF"
            android:backgroundTint="#1976D2" />
    </LinearLayout>

</LinearLayout>
