    <string name="title_manage_quick_actions">مدیریت ردیف عملیات سریع بالای حروف</string>
    <string name="desc_manage_quick_actions">حذف یا پنهان کردن ابزارهای بالای حروف (پاک کردن همه، خواندن، چسباندن)</string>
    <string name="title_sound_haptic">صدا و لرزش</string>
    <string name="desc_sound_haptic">صدای فشردن کلیدها و میزان ویبره به میلی‌ثانیه</string>
    <string name="title_typing_speed">سرعت تایپ و پاسخگویی</string>
    <string name="desc_typing_speed">سرعت تکرار کلید، حذف سریع و زمان پاسخ لمسی</string>
    <string name="title_height_font">ارتفاع صفحه‌کلید و اندازه حروف</string>
    <string name="desc_height_font">تنظیم ارتفاع کلی کیبورد و اندازه نویسه‌های روی کلیدها</string>
    <string name="title_customization">ابعاد پیشرفته</string>
    <string name="desc_customization">اندازه‌گیری دقیق نوار ابزار و کلیدها</string>
    <string name="title_backup">پشتیبان‌گیری و بازیابی</string>
    <string name="desc_backup">پشتیبان‌گیری از کلیپ‌بورد و میانبرها</string>
    <string name="title_restore_defaults">بازگردانی تنظیمات کارخانه</string>
    <string name="desc_restore_defaults">بازگرداندن تمام تنظیمات، تم‌ها و کلیدها به حالت اولیه</string>
