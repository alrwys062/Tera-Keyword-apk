    <string name="title_rows_toolbar">ردیف اعداد و نوار ابزار</string>
    <string name="desc_rows_toolbar">نمایش ردیف اعداد و کنترل نوار ابزار</string>
    <string name="title_customize_toolbar">سفارشی‌سازی نوار ابزار</string>
