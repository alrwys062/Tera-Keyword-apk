    <string name="title_ai_tone">هوش مصنوعی و تغییر لحن متن</string>
    <string name="desc_ai_tone">بازنویسی متن به لحن رسمی، صمیمی، کوتاه یا شاعرانه</string>
    <string name="title_dictionary">فرهنگ لغت و اصلاح املایی</string>
